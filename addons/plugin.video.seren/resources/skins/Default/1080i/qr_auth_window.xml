<?xml version="1.0" encoding="UTF-8"?>
<window>
	<coordinates>
		<left>0</left>
		<top>0</top>
		<width>1920</width>
		<height>1080</height>
	</coordinates>

	<defaultcontrol always="true">200</defaultcontrol>

	<controls>

		<!-- Background -->
		<control type="group">
			<top>0</top>
			<left>0</left>
			<width>1920</width>
			<height>1080</height>

			<!-- Fallback -->
			<control type="image">
				<texture>white.png</texture>
				<colordiffuse>FF000000</colordiffuse>
			</control>

			<!-- Fanart -->
			<control type="image">
				<texture background="true">$INFO[Window().Property(seren.fanart)]</texture>
				<colordiffuse>66FFFFFF</colordiffuse>
			</control>

			<!-- Overlay -->
			<control type="image">
				<texture background="true">white.png</texture>
				<colordiffuse>CC000000</colordiffuse>
			</control>
		</control>

		<!-- Card -->
		<control type="group">
			<left>510</left>
			<top>140</top>
			<width>900</width>
			<height>800</height>

			<control type="image">
				<width>900</width>
				<height>800</height>
				<texture>white.png</texture>
				<colordiffuse>D9161616</colordiffuse>
			</control>

			<!-- Heading -->
			<control type="label">
				<top>40</top>
				<left>0</left>
				<width>900</width>
				<height>40</height>
				<align>center</align>
				<label>[UPPERCASE][COLOR $INFO[Window().Property(settings.color)]]$INFO[Window().Property(qrauth.title)][/COLOR][/UPPERCASE]</label>
				<font>font37</font>
				<textcolor>white</textcolor>
			</control>

			<!-- QR code - white backing plate ensures scan contrast regardless of theme -->
			<control type="image">
				<top>110</top>
				<left>280</left>
				<width>340</width>
				<height>340</height>
				<texture>white.png</texture>
			</control>
			<control type="image" id="100">
				<top>120</top>
				<left>290</left>
				<width>320</width>
				<height>320</height>
				<texture>$INFO[Window().Property(qrauth.image)]</texture>
				<aspectratio>keep</aspectratio>
			</control>

			<!-- Verification URL -->
			<control type="label">
				<top>475</top>
				<left>40</left>
				<width>820</width>
				<height>30</height>
				<align>center</align>
				<label>$INFO[Window().Property(qrauth.url)]</label>
				<font>font12</font>
				<textcolor>66FFFFFF</textcolor>
			</control>

			<!-- Code -->
			<control type="label">
				<top>515</top>
				<left>40</left>
				<width>820</width>
				<height>60</height>
				<align>center</align>
				<label>[B]$INFO[Window().Property(qrauth.code)][/B]</label>
				<font>font32</font>
				<textcolor>$INFO[Window().Property(settings.color)]</textcolor>
			</control>

			<!-- Status / countdown -->
			<control type="label">
				<top>595</top>
				<left>40</left>
				<width>820</width>
				<height>30</height>
				<align>center</align>
				<label>$INFO[Window().Property(qrauth.status)]</label>
				<font>font12</font>
				<textcolor>66FFFFFF</textcolor>
			</control>

			<!-- Cancel -->
			<control type="button" id="200">
				<top>690</top>
				<left>350</left>
				<width>200</width>
				<height>60</height>
				<label>$ADDON[plugin.video.seren 30070]</label>
				<font>font13</font>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$INFO[Window().Property(settings.color)]">white.png</texturefocus>
				<texturenofocus colordiffuse="66FFFFFF">white.png</texturenofocus>
				<textcolor>black</textcolor>
				<focusedcolor>black</focusedcolor>
			</control>

		</control>

	</controls>
</window>
