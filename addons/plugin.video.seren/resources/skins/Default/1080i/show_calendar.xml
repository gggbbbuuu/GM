<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
	<!-- My Watch List Calendar and TV Shows Daily Calendar (show_calendar_window.py), in Seren's window style: fanart under a dark
	     wash, cards (99362e33 / FF362e33 focused), settings.color for accents and focus, buttons as in movie_calendar.xml.
	     Properties set by the window:
	       window: window_title, center_label, view_unwatched, empty_text, day_mode (one day per page), not_today (shows Today)
	       rows:   row_type (show / episode), show_summary, air_state (watched / aired / today / unaired), air_status, row_date,
	               air_time (local air time), row_badge (Premiere / New show), rating_display -->
