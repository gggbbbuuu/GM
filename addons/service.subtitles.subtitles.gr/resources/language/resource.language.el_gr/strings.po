msgctxt "#30002"
msgid "This service is only for Greek subtitles"
msgstr "Υπηρεσία μόνο ελληνικών υποτίτλων"

msgctxt "#30003"
msgid "Cache results"
msgstr "Αποθήκευση αποτελεσμάτων"

msgctxt "#30004"
msgid "Keep subtitles"
msgstr "Αποθήκευση υποτίτλων"

msgctxt "#30005"
msgid "Output folder"
msgstr "Διαδρομή αποθήκευσης"

msgctxt "#30006"
msgid "Keep zips (GreekSubs.net only)"
msgstr "Αποθήκευση των zip (μόνο GreekSubs.net)"

msgctxt "#30008"
msgid "Subtitle has been saved"
msgstr "Ο υπότιτλος αποθηκεύτηκε"

msgctxt "#30009"
msgid "Destination"
msgstr "Προορισμός"

msgctxt "#30010"
msgid "Locally in a movie subfolder (in case of failure will save to the folder below)"
msgstr "Τοπικά σε έναν υποφάκελο ταινίας (σε περίπτωση αποτυχίας θα αποθηκευσει στο παρακάτω φάκελο)"

msgctxt "#30011"
msgid "Manual choice"
msgstr "Χειροκίνητη επιλογή"

msgctxt "#30012"
msgid "Auto extract zips"
msgstr "Αυτόματη αποσυμπίεση των zip"

msgctxt "#30013"
msgid "Could not save the subtitles"
msgstr "Αδυναμία αποθήκευσης των υποτίτλων"

msgctxt "#30032"
msgid "Archives (GreekSubs.net season packs only)"
msgstr "Αρχεία (μόνο πακέτα σεζόν του GreekSubs.net)"

msgctxt "#30015"
msgid "Overwrite existing subs?"
msgstr "Εγγραφή από πάνω στους υπάρχοντες υποτίτλους;"

msgctxt "#30016"
msgid "Both manual and local"
msgstr "Και τοπικά και στον χειροκίνητο προορισμό"

msgctxt "#30214"
msgid "Package contains multiple subtitles"
msgstr "Το πακέτο περιέχει πολλαπλούς υποτίτλους"

msgctxt "#30215"
msgid "Random choice"
msgstr "Τυχαία επιλογή"

msgctxt "#30216"
msgid "Actions"
msgstr "Ενέργειες"

msgctxt "#30217"
msgid "Delete function cache"
msgstr "Διαγραφή μνήμης λειτουργιών"

msgctxt "#30218"
msgid "Domains"
msgstr "Ιστότοποι"

msgctxt "#30219"
msgid "Options"
msgstr "Επιλογές"

msgctxt "#30220"
msgid "Sorting"
msgstr "Ταξινόμιση"

msgctxt "#30221"
msgid "Name"
msgstr "Όνομα"

msgctxt "#30222"
msgid "Source"
msgstr "Πηγή"

msgctxt "#30223"
msgid "Downloads"
msgstr "Μεταφορτώσεις"

msgctxt "#30224"
msgid "Rating"
msgstr "Αξιολόγηση"

msgctxt "#30225"
msgid "Disable for faster searches"
msgstr "Ταχύτερες αναζητήσεις με απενεργοποίηση"

msgctxt "#30226"
msgid "Timeout in seconds"
msgstr "Χρόνος λήξης σε δευτερόλεπτα"

msgctxt "#30228"
msgid "Increase search queries for episode titles"
msgstr "Αύξηση όρων αναζήτησης για τους τίτλους επεισοδίων"

msgctxt "#30231"
msgid "Sync probability level"
msgstr "Επίπεδο πιθανότητας συγχρονισμού"

msgctxt "#30240"
msgid "Subs4Series"
msgstr "Subs4Series"

msgctxt "#30241"
msgid "Subs4Series limits downloads behind a captcha.\nOpen a series page in your browser and clear the captcha,\nthen copy the PHPSESSID cookie here to allow downloads."
msgstr "Το Subs4Series περιορίζει τις λήψεις με captcha.\nΑνοίξτε μια σελίδα σειράς στον browser σας και λύστε το captcha,\nκαι αντιγράψτε εδώ το cookie PHPSESSID για να επιτρέπονται οι λήψεις."

msgctxt "#30242"
msgid "Session cookie (PHPSESSID)"
msgstr "Session cookie (PHPSESSID)"

msgctxt "#30252"
msgid "Install curl_cffi dependency"
msgstr "Εγκατάσταση εξάρτησης curl_cffi"

msgctxt "#30262"
msgid "Session saved"
msgstr "Το session αποθηκεύτηκε"

msgctxt "#30271"
msgid "Install %s?\n\nRequired for Subs4Series search."
msgstr "Εγκατάσταση του %s;\n\nΑπαιτείται για την αναζήτηση στο Subs4Series."

msgctxt "#30272"
msgid "Installation could not be completed.\n\nEnable a repository that hosts %s and try again."
msgstr "Η εγκατάσταση δεν ολοκληρώθηκε.\n\nΕνεργοποιήστε ένα αποθετήριο που περιέχει το %s και δοκιμάστε ξανά."

msgctxt "#30273"
msgid "curl_cffi enabled, restart Kodi"
msgstr "Το curl_cffi ενεργοποιήθηκε, επανεκκινήστε το Kodi"

msgctxt "#30274"
msgid "%s could not be enabled."
msgstr "Δεν ήταν δυνατή η ενεργοποίηση του %s."

msgctxt "#30276"
msgid "Enable %s %s?"
msgstr "Ενεργοποίηση του %s %s;"

msgctxt "#30277"
msgid "curl_cffi ready"
msgstr "Το curl_cffi είναι έτοιμο"

msgctxt "#30280"
msgid "Cache deleted"
msgstr "Η κρυφή μνήμη διεγράφη"

msgctxt "#30281"
msgid "Searching subtitles"
msgstr "Αναζήτηση υποτίτλων"

msgctxt "#30282"
msgid "Querying sources"
msgstr "Αναζήτηση στις πηγές"

msgctxt "#30283"
msgid "Downloading subtitle"
msgstr "Λήψη υποτίτλων"

msgctxt "#30284"
msgid "Providers below need curl_cffi installed"
msgstr "Οι παρακάτω πάροχοι χρειάζονται εγκατεστημένο το curl_cffi"

msgctxt "#30285"
msgid "Search Subtitles.gr. The site is currently unreachable, so leave this off."
msgstr "Αναζήτηση στο Subtitles.gr. Ο ιστότοπος δεν αποκρίνεται προς το παρόν, αφήστε το απενεργοποιημένο."

msgctxt "#30286"
msgid "Search GreekSubs.net for Greek subtitles, including whole-season packs."
msgstr "Αναζήτηση στο GreekSubs.net για ελληνικούς υπότιτλους, συμπεριλαμβανομένων πακέτων σεζόν."

msgctxt "#30287"
msgid "Search Subs4Free for Greek movie subtitles. Works without extra addons."
msgstr "Αναζήτηση στο Subs4Free για ελληνικούς υπότιτλους ταινιών. Λειτουργεί χωρίς πρόσθετα addons."

msgctxt "#30288"
msgid "Search YIFI for Greek movie subtitles."
msgstr "Αναζήτηση στο YIFI για ελληνικούς υπότιτλους ταινιών."

msgctxt "#30289"
msgid "Search TVsubtitles.net for Greek series subtitles."
msgstr "Αναζήτηση στο TVsubtitles.net για ελληνικούς υπότιτλους σειρών."

msgctxt "#30290"
msgid "Search Moviesubtitles.org for Greek movie subtitles."
msgstr "Αναζήτηση στο Moviesubtitles.org για ελληνικούς υπότιτλους ταινιών."

msgctxt "#30291"
msgid "Search Subs4Series for Greek series subtitles. Needs script.module.curlcffi installed."
msgstr "Αναζήτηση στο Subs4Series για ελληνικούς υπότιτλους σειρών. Χρειάζεται εγκατεστημένο το script.module.curlcffi."

msgctxt "#30292"
msgid "Search SubDL for Greek subtitles. Needs script.module.curlcffi installed."
msgstr "Αναζήτηση στο SubDL για ελληνικούς υπότιτλους. Χρειάζεται εγκατεστημένο το script.module.curlcffi."

msgctxt "#30293"
msgid "Order of the subtitle results list."
msgstr "Σειρά εμφάνισης της λίστας υποτίτλων."

msgctxt "#30294"
msgid "Keep search results in the cache for faster repeated searches."
msgstr "Διατήρηση των αποτελεσμάτων αναζήτησης στην κρυφή μνήμη για ταχύτερες επαναλαμβανόμενες αναζητήσεις."

msgctxt "#30295"
msgid "Run extra title variants when searching episodes. Slower but finds more."
msgstr "Εκτέλεση επιπλέον παραλλαγών τίτλου κατά την αναζήτηση επεισοδίων. Πιο αργό αλλά βρίσκει περισσότερα."

msgctxt "#30296"
msgid "Seconds to wait for a search response before giving up."
msgstr "Δευτερόλεπτα αναμονής απάντησης αναζήτησης πριν την εγκατάλειψη."

msgctxt "#30298"
msgid "Minimum filename match score for a subtitle to be marked as in sync."
msgstr "Ελάχιστη βαθμολογία ταύτισης ονόματος αρχείου για να χαρακτηριστεί ένας υπότιτλος συγχρονισμένος."

msgctxt "#30299"
msgid "Save a copy of every downloaded subtitle."
msgstr "Αποθήκευση αντιγράφου κάθε υπότιτλου που λαμβάνεται."

msgctxt "#30300"
msgid "Keep the downloaded season pack archive instead of only the chosen subtitle."
msgstr "Διατήρηση του αρχείου πακέτου σεζόν αντί μόνο του επιλεγμένου υπότιτλου."

msgctxt "#30301"
msgid "Unpack season pack archives and let you pick the episode subtitle."
msgstr "Αποσυμπίεση των αρχείων πακέτων σεζόν και επιλογή του υπότιτλου επεισοδίου."

msgctxt "#30302"
msgid "Where to save kept subtitles."
msgstr "Προορισμός αποθήκευσης των υπότιτλων."

msgctxt "#30303"
msgid "Folder used when the destination is not next to the video."
msgstr "Φάκελος που χρησιμοποιείται όταν ο προορισμός δεν είναι δίπλα στο βίντεο."

msgctxt "#30304"
msgid "Paste the PHPSESSID cookie solved in your browser to allow Subs4Series downloads."
msgstr "Επικολλήστε το cookie PHPSESSID που λύσατε στον browser για να επιτρέπονται οι λήψεις του Subs4Series."

msgctxt "#30306"
msgid "Delete all cached search results. Use after provider changes."
msgstr "Διαγραφή όλων των αποθηκευμένων αποτελεσμάτων. Χρήση μετά από αλλαγές παρόχων."

msgctxt "#30307"
msgid "Install the optional curl_cffi addon, needed by Subs4Series and SubDL."
msgstr "Εγκατάσταση του προαιρετικού addon curl_cffi, που χρειάζονται τα Subs4Series και SubDL."

msgctxt "#30308"
msgid "Subtitles.gr"
msgstr "Subtitles.gr"

msgctxt "#30309"
msgid "GreekSubs.net"
msgstr "GreekSubs.net"

msgctxt "#30310"
msgid "Subs4Free (movies)"
msgstr "Subs4Free (ταινίες)"

msgctxt "#30311"
msgid "YIFI"
msgstr "YIFI"

msgctxt "#30312"
msgid "TVsubtitles.net"
msgstr "TVsubtitles.net"

msgctxt "#30313"
msgid "Moviesubtitles.org"
msgstr "Moviesubtitles.org"

msgctxt "#30314"
msgid "Subs4Series"
msgstr "Subs4Series"

msgctxt "#30315"
msgid "SubDL"
msgstr "SubDL"

msgctxt "#30316"
msgid "Translate fallback (English → Greek)"
msgstr "Εφεδρική μετάφραση (Αγγλικά → Ελληνικά)"

msgctxt "#30317"
msgid "Fetch English subtitles alongside Greek results and machine-translate them at download. Slow (~1 minute per download), needs curl_cffi."
msgstr "Λήψη αγγλικών υποτίτλων μαζί με τους ελληνικούς και αυτόματη μετάφρασή τους κατά τη λήψη. Αργό (~1 λεπτό ανά λήψη), χρειάζεται curl_cffi."

msgctxt "#30318"
msgid "Delete saved subtitles"
msgstr "Διαγραφή αποθηκευμένων υποτίτλων"

msgctxt "#30319"
msgid "Choose saved subtitle files to delete from the output folder."
msgstr "Επιλογή αποθηκευμένων αρχείων υποτίτλων για διαγραφή από το φάκελο."

msgctxt "#30320"
msgid "Saved subtitles"
msgstr "Αποθηκευμένοι υπότιτλοι"

msgctxt "#30321"
msgid "Deleted %d subtitle(s)."
msgstr "Διαγράφηκαν %d υπότιτλοι."

msgctxt "#30322"
msgid "No saved subtitles found."
msgstr "Δε βρέθηκαν αποθηκευμένοι υπότιτλοι."

msgctxt "#30323"
msgid "Translating subtitle"
msgstr "Μετάφραση υποτίτλου"

msgctxt "#30324"
msgid "Addic7ed (series, English)"
msgstr "Addic7ed (σειρές, Αγγλικά)"

msgctxt "#30325"
msgid "Include Addic7ed English series subtitles in the translation fallback."
msgstr "Συμπερίληψη αγγλικών υπότιτλων σειρών του Addic7ed στην εφεδρική μετάφραση."

msgctxt "#30326"
msgid "Subtitle could not be downloaded"
msgstr "Ο υπότιτλος δεν μπόρεσε να ληφθεί"

msgctxt "#30327"
msgid "Subs4Series downloads need its captcha solved in your browser. No subtitle was downloaded."
msgstr "Οι λήψεις από το Subs4Series απαιτούν επίλυση captcha στον περιηγητή σας. Δεν κατέβηκε υπότιτλος."

msgctxt "#30328"
msgid "Import session cookie (bookmarklet)"
msgstr "Εισαγωγή cookie συνεδρίας (bookmarklet)"

msgctxt "#30329"
msgid "Starts a short-lived local listener and shows an address. Open that address in a browser on the same network, drag the bookmarklet to the bookmarks bar, then click it while on the Subs4Series page."
msgstr "Ξεκινά έναν προσωρινό τοπικό listener και εμφανίζει μια διεύθυνση. Ανοίξτε τη διεύθυνση σε περιηγητή στο ίδιο δίκτυο, σύρετε το bookmarklet στη γραμμή σελιδοδεικτών και μετά πατήστε το στη σελίδα του Subs4Series. Το Kodi ανοίγει τον ίδιο listener και μόνο του όταν μια λήψη από το Subs4Series χρειάζεται επίλυση captcha σε περιηγητή."

msgctxt "#30330"
msgid "Subs4Series session cookie"
msgstr "Cookie συνεδρίας Subs4Series"

msgctxt "#30331"
msgid "Open in a browser on the same network:"
msgstr "Ανοίξτε σε περιηγητή στο ίδιο δίκτυο:"

msgctxt "#30332"
msgid "Then go to Subs4Series and click the bookmarklet."
msgstr "Μετά πηγαίνετε στο Subs4Series και πατήστε το bookmarklet."

msgctxt "#30333"
msgid "Waiting for the cookie, %d s left"
msgstr "Αναμονή για το cookie, %d δεπ. ακόμη"

msgctxt "#30334"
msgid "Timed out. No cookie was received."
msgstr "Έληξε ο χρόνος. Δεν ελήφθη cookie."

msgctxt "#30335"
msgid "Subs4Series cookie import"
msgstr "Εισαγωγή cookie Subs4Series"

msgctxt "#30336"
msgid "This page hands over the session cookie from your own logged-in browser. Nothing is solved or bypassed."
msgstr "Αυτή η σελίδα παραδίδει το cookie συνεδρίας από τον δικό σας συνδεδεμένο περιηγητή. Δεν λύνεται και δεν παρακάμπτεται τίποτα."

msgctxt "#30338"
msgid "Open Subs4Series in the same browser, find a subtitle, then click the bookmark."
msgstr "Ανοίξτε το Subs4Series στον ίδιο περιηγητή, βρείτε έναν υπότιτλο και πατήστε τον σελιδοδείκτη."

msgctxt "#30339"
msgid "Import to Kodi"
msgstr "Εισαγωγή στο Kodi"

msgctxt "#30341"
msgid "Or paste the cookie value, or your browser's Copy as cURL text, here:"
msgstr "Ή επικολλήστε την τιμή του cookie, ή το κείμενο Copy as cURL του περιηγητή σας, εδώ:"

msgctxt "#30342"
msgid "Send to Kodi"
msgstr "Αποστολή στο Kodi"

msgctxt "#30343"
msgid "Waiting for the cookie..."
msgstr "Αναμονή για το cookie..."

msgctxt "#30344"
msgid "Received! You can close this tab."
msgstr "Ελήφθη! Μπορείτε να κλείσετε αυτή την καρτέλα."

msgctxt "#30345"
msgid "No cookie found in what was sent."
msgstr "Δεν βρέθηκε cookie σε αυτά που στάλθηκαν."

msgctxt "#30346"
msgid "This link is no longer valid. Reopen it from Kodi."
msgstr "Ο σύνδεσμος δεν ισχύει πλέον. Ανοίξτε τον ξανά από το Kodi."

msgctxt "#30347"
msgid "No network address found. Check that this device is on a network."
msgstr "Δεν βρέθηκε διεύθυνση δικτύου. Ελέγξτε ότι η συσκευή είναι σε δίκτυο."

msgctxt "#30348"
msgid "Could not start the listener."
msgstr "Δεν ήταν δυνατή η εκκίνηση του listener."

msgctxt "#30349"
msgid "Listener port for cookie import"
msgstr "Θύρα listener για εισαγωγή cookie"

msgctxt "#30350"
msgid "Ships fixed at 50190 so the listener keeps the same address and the bookmarklet only has to be installed once. Clear the field to use any free port instead. Nothing listens there except while the import dialog is open."
msgstr "Έρχεται σταθερή στο 50190 ώστε ο listener να κρατά την ίδια διεύθυνση και το bookmarklet να εγκαθίσταται μία φορά. Αδειάστε το πεδίο για χρήση οποιασδήποτε ελεύθερης θύρας. Τίποτα δεν ακούει εκεί παρά μόνο όσο είναι ανοιχτός ο διάλογος εισαγωγής."

msgctxt "#30351"
msgid "Port %d is in use, using %d instead."
msgstr "Η θύρα %d χρησιμοποιείται, χρήση της %d."

msgctxt "#30352"
msgid "Import token"
msgstr "Διακριτικό εισαγωγής"

msgctxt "#30353"
msgid "Secret carried by the import bookmarklet so that only your browser can hand over a cookie. Clear this value to mint a new one; every bookmarklet created before that stops working."
msgstr "Μυστικό που μεταφέρει το bookmarklet εισαγωγής, ώστε μόνο ο περιηγητής σας να μπορεί να παραδώσει cookie. Διαγράψτε την τιμή για να δημιουργηθεί νέο· κάθε σελιδοδείκτης που φτιάχτηκε πριν σταματά να λειτουργεί."

msgctxt "#30354"
msgid "Open this page in your browser:"
msgstr "Ανοίξτε αυτή τη σελίδα στον περιηγητή σας:"

msgctxt "#30355"
msgid "The captcha was not accepted. Tick the box on the page, then click the bookmarklet again."
msgstr "Το captcha δεν έγινε δεκτό. Τσεκάρετε το κουτάκι στη σελίδα και μετά πατήστε ξανά το bookmarklet."

msgctxt "#30356"
msgid "Subs4Series captcha"
msgstr "Captcha του Subs4Series"

msgctxt "#30357"
msgid "Solve the captcha on that page, then click the bookmarklet."
msgstr "Λύστε το captcha σε εκείνη τη σελίδα και μετά πατήστε το bookmarklet."

msgctxt "#30358"
msgid "Waiting for the subtitle, %d s left"
msgstr "Αναμονή για τον υπότιτλο, %d δεπ. ακόμη"

msgctxt "#30359"
msgid "Timed out. No subtitle was received."
msgstr "Έληξε ο χρόνος. Δεν ελήφθη υπότιτλος."

msgctxt "#30360"
msgid "Solve the captcha in your browser; nothing is bypassed."
msgstr "Λύστε το captcha στον περιηγητή σας· τίποτα δεν παρακάμπτεται."

msgctxt "#30361"
msgid "Open in browser"
msgstr "Άνοιγμα στον περιηγητή"

msgctxt "#30362"
msgid "Cancel"
msgstr "Άκυρο"

msgctxt "#30363"
msgid "Scan this with your phone:"
msgstr "Σαρώστε το με το κινητό σας:"

msgctxt "#30364"
msgid "Received."
msgstr "Ελήφθη."

msgctxt "#30365"
msgid "Copy the bookmarklet"
msgstr "Αντιγραφή του bookmarklet"

msgctxt "#30366"
msgid "Copied."
msgstr "Αντιγράφηκε."

msgctxt "#30367"
msgid "In Firefox for Android: open Bookmarks, tap the menu and Add bookmark, then paste what you copied into the address field. Open the Subs4Series page and tap the bookmark from the bookmarks list. Tapping the bookmark is what runs it; typing its name in the address bar only searches."
msgstr "Στον Firefox για Android: ανοίξτε τους Σελιδοδείκτες, πατήστε το μενού και «Προσθήκη σελιδοδείκτη», έπειτα επικολλήστε ό,τι αντιγράψατε στο πεδίο διεύθυνσης. Ανοίξτε τη σελίδα του Subs4Series και πατήστε τον σελιδοδείκτη από τη λίστα σελιδοδεικτών. Το πάτημα τον εκτελεί· το όνομά του στη γραμμή διεύθυνσης κάνει μόνο αναζήτηση."

msgctxt "#30368"
msgid "This browser cannot run a bookmarklet and searches instead. Open this page in Firefox for Android, add the bookmark there, then tap it from the bookmarks list."
msgstr "Αυτός ο περιηγητής δεν εκτελεί bookmarklet και κάνει αναζήτηση αντί γι' αυτό. Ανοίξτε αυτή τη σελίδα στον Firefox για Android, προσθέστε εκεί τον σελιδοδείκτη και πατήστε τον από τη λίστα σελιδοδεικτών."

msgctxt "#30369"
msgid "On iPhone and iPad: add a bookmark, edit it, paste what you copied as its address, then tap it from your bookmarks list. Chrome, Vivaldi and Firefox for iOS cannot run it."
msgstr "Σε iPhone και iPad: προσθέστε έναν σελιδοδείκτη, επεξεργαστείτε τον, επικολλήστε ό,τι αντιγράψατε ως διεύθυνσή του και πατήστε τον από τη λίστα σελιδοδεικτών. Οι Chrome, Vivaldi και Firefox σε iOS δεν τον εκτελούν."

msgctxt "#30370"
msgid "On a desktop: drag the button above to the bookmarks bar, or open the Subs4Series page, open the browser console with F12, paste what you copied and press Enter."
msgstr "Σε υπολογιστή: σύρετε το κουμπί πιο πάνω στη γραμμή σελιδοδεικτών ή ανοίξτε τη σελίδα του Subs4Series, ανοίξτε την κονσόλα του περιηγητή με F12, επικολλήστε ό,τι αντιγράψατε και πατήστε Enter."

msgctxt "#30371"
msgid "On a phone use Firefox for Android, or Safari on iPhone and iPad: add the text above as a bookmark, then tap it from your bookmarks list. The address bar only searches."
msgstr "Σε κινητό χρησιμοποιήστε τον Firefox για Android ή το Safari σε iPhone και iPad: προσθέστε το πιο πάνω κείμενο ως σελιδοδείκτη και πατήστε τον από τη λίστα σελιδοδεικτών. Η γραμμή διεύθυνσης κάνει μόνο αναζήτηση."

msgctxt "#30372"
msgid "Waiting for the cookie, %d min %d s left"
msgstr "Αναμονή για το cookie, %d λεπ. %d δεπ. ακόμη"

msgctxt "#30373"
msgid "Waiting for the subtitle, %d min %d s left"
msgstr "Αναμονή για τον υπότιτλο, %d λεπ. %d δεπ. ακόμη"

msgctxt "#30374"
msgid "Skip the bookmarklet: let the browser do it"
msgstr "Χωρίς bookmarklet: αφήστε τον περιηγητή να το κάνει"

msgctxt "#30375"
msgid "Install the Violentmonkey extension once, then install the helper below. After that, ticking the captcha is enough: the page hands the subtitle over by itself."
msgstr "Εγκαταστήστε μία φορά την επέκταση Violentmonkey και μετά το βοηθητικό σενάριο παρακάτω. Από εκεί και πέρα αρκεί να λύνετε το captcha: η σελίδα παραδίδει μόνη της τον υπότιτλο."

msgctxt "#30376"
msgid "1. Get Violentmonkey"
msgstr "1. Εγκαταστήστε το Violentmonkey"

msgctxt "#30377"
msgid "For Firefox (desktop and Android) and Chrome: from the add-ons store of your browser. For Vivaldi on Android: Extensions button, Open Chrome Web Store, search Violentmonkey. Violentmonkey is free and open source; Tampermonkey works too."
msgstr "Για Firefox (υπολογιστή και Android) και Chrome: από το κατάστημα προσθέτων του περιηγητή σας. Για Vivaldi σε Android: κουμπί Επεκτάσεις, Άνοιγμα Chrome Web Store, αναζήτηση Violentmonkey. Το Violentmonkey είναι δωρεάν και ανοιχτού κώδικα· δουλεύει και το Tampermonkey."

msgctxt "#30378"
msgid "2. Install the Subtitles.gr helper"
msgstr "2. Εγκαταστήστε το βοηθητικό σενάριο Subtitles.gr"

msgctxt "#30379"
msgid "Open the link below in the same browser. Violentmonkey offers to install it; confirm. It runs only on Subs4Series pages and only after you tick the captcha."
msgstr "Ανοίξτε τον παρακάτω σύνδεσμο στον ίδιο περιηγητή. Το Violentmonkey προτείνει την εγκατάσταση· επιβεβαιώστε. Τρέχει μόνο σε σελίδες του Subs4Series και μόνο αφού λύσετε το captcha."

msgctxt "#30380"
msgid "Install the Subtitles.gr helper"
msgstr "Εγκατάσταση του βοηθητικού σεναρίου Subtitles.gr"

msgctxt "#30381"
msgid "Get Violentmonkey from the Chrome Web Store"
msgstr "Λήψη του Violentmonkey από το Chrome Web Store"

msgctxt "#30382"
msgid "Or use the bookmarklet instead"
msgstr "Ή χρησιμοποιήστε το bookmarklet"
