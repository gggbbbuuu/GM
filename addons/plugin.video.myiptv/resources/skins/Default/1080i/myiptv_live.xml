				</control>
				<control type="label">
					<left>110</left>
					<top>4</top>
					<width>920</width>
					<height>40</height>
					<font>font13</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>110</left>
					<top>48</top>
					<width>190</width>
					<height>34</height>
					<font>font12</font>
					<textcolor>FFF2C94C</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
				<control type="label">
					<left>300</left>
