					<top>88</top>
					<width>980</width>
					<height>4</height>
					<texturebg colordiffuse="FF30363D">white.png</texturebg>
					<midtexture colordiffuse="FF3FB950">white.png</midtexture>
					<info>ListItem.Property(pct)</info>
				</control>
				<control type="image">
					<visible>Player.HasMedia + String.IsEqual(ListItem.Property(playing),1)</visible>
					<left>1052</left>
					<top>28</top>
					<width>40</width>
					<height>40</height>
					<texture colordiffuse="FF3FB950">play.png</texture>
				</control>
			</itemlayout>
			<focusedlayout height="96" width="1110">
				<control type="image">
					<left>0</left>
