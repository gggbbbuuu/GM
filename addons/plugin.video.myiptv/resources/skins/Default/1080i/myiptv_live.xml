<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<controls>
		<!-- only the add-on's own texture (white.png) and the font names every skin defines are used, so the window
		     looks the same in any skin; drawn in 1920x1080 units, Kodi scales it to the screen -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="FF0D1117">white.png</texture>
		</control>
		<control type="label">
			<left>60</left>
			<top>28</top>
			<width>1800</width>
			<height>60</height>
			<font>font14</font>
			<textcolor>FFFFFFFF</textcolor>
			<label>$INFO[Window.Property(title)]</label>
		</control>
		<control type="list" id="50">
			<left>60</left>
			<top>110</top>
			<width>1110</width>
			<height>930</height>
			<orientation>vertical</orientation>
			<scrolltime>150</scrolltime>
			<onup>60</onup>
			<onright>62</onright>
			<onright>60</onright>
			<itemlayout height="96" width="1110">
				<control type="image">
					<left>10</left>
					<top>8</top>
					<width>80</width>
					<height>80</height>
					<aspectratio>keep</aspectratio>
					<texture>$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>110</left>
					<top>4</top>
					<width>920</width>
					<height>40</height>
					<font>font13</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>110</left>
					<top>48</top>
					<width>190</width>
					<height>34</height>
					<font>font12</font>
					<textcolor>FFF2C94C</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
				<control type="label">
					<left>300</left>
					<top>48</top>
					<width>730</width>
					<height>34</height>
					<font>font12</font>
					<textcolor>FF7DD3FC</textcolor>
					<label>$INFO[ListItem.Property(now)]</label>
				</control>
				<control type="progress">
					<visible>!String.IsEmpty(ListItem.Property(now))</visible>
					<left>110</left>
					<top>88</top>
					<width>980</width>
					<height>4</height>
					<texturebg colordiffuse="FF30363D">white.png</texturebg>
					<midtexture colordiffuse="FF3FB950">white.png</midtexture>
					<info>ListItem.Property(pct)</info>
				</control>
				<control type="image">
					<visible>Player.HasVideo + String.IsEqual(ListItem.Property(playing),1)</visible>
					<left>1052</left>
					<top>28</top>
					<width>40</width>
					<height>40</height>
					<texture colordiffuse="FF3FB950">play.png</texture>
				</control>
			</itemlayout>
			<focusedlayout height="96" width="1110">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1110</width>
					<height>96</height>
					<texture colordiffuse="FF1F4E8C">white.png</texture>
				</control>
				<control type="image">
					<left>10</left>
					<top>8</top>
					<width>80</width>
					<height>80</height>
					<aspectratio>keep</aspectratio>
					<texture>$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>110</left>
					<top>4</top>
					<width>920</width>
					<height>40</height>
					<font>font13</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>110</left>
					<top>48</top>
					<width>190</width>
					<height>34</height>
					<font>font12</font>
					<textcolor>FFF2C94C</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
				<control type="label">
					<left>300</left>
					<top>48</top>
					<width>730</width>
					<height>34</height>
					<font>font12</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.Property(now)]</label>
				</control>
				<control type="progress">
					<visible>!String.IsEmpty(ListItem.Property(now))</visible>
					<left>110</left>
					<top>88</top>
					<width>980</width>
					<height>4</height>
					<texturebg colordiffuse="FF30363D">white.png</texturebg>
					<midtexture colordiffuse="FF3FB950">white.png</midtexture>
					<info>ListItem.Property(pct)</info>
				</control>
				<control type="image">
					<visible>Player.HasVideo + String.IsEqual(ListItem.Property(playing),1)</visible>
					<left>1052</left>
					<top>28</top>
					<width>40</width>
					<height>40</height>
					<texture colordiffuse="FFFFFFFF">play.png</texture>
				</control>
			</focusedlayout>
		</control>
		<control type="group">
			<left>1210</left>
			<top>110</top>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>650</width>
				<height>930</height>
				<texture colordiffuse="FF161B22">white.png</texture>
			</control>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>650</width>
				<height>366</height>
				<font>font12</font>
				<textcolor>FF8B949E</textcolor>
				<align>center</align>
				<aligny>center</aligny>
				<visible>!Player.HasVideo</visible>
				<label>Επιλέξτε κανάλι</label>
			</control>
			<control type="videowindow">
				<left>0</left>
				<top>0</top>
				<width>650</width>
				<height>366</height>
			</control>
			<control type="label">
				<left>30</left>
				<top>380</top>
				<width>590</width>
				<height>44</height>
				<font>font14</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>$INFO[Container(50).ListItem.Label]</label>
			</control>
			<control type="label">
				<left>30</left>
				<top>432</top>
				<width>590</width>
				<height>34</height>
				<font>font12</font>
				<textcolor>FF8B949E</textcolor>
				<label>ΤΩΡΑ</label>
				<visible>!String.IsEmpty(Container(50).ListItem.Property(now))</visible>
			</control>
			<control type="textbox">
				<left>30</left>
				<top>468</top>
				<width>590</width>
				<height>90</height>
				<font>font13</font>
				<textcolor>FF7DD3FC</textcolor>
				<label>$INFO[Container(50).ListItem.Label2,[COLOR FFF2C94C],[/COLOR]  ]$INFO[Container(50).ListItem.Property(now)]</label>
				<visible>!String.IsEmpty(Container(50).ListItem.Property(now))</visible>
			</control>
			<control type="label">
				<left>30</left>
				<top>566</top>
				<width>590</width>
				<height>34</height>
				<font>font12</font>
				<textcolor>FF8B949E</textcolor>
				<label>ΕΠΟΜΕΝΑ</label>
				<visible>!String.IsEmpty(Container(50).ListItem.Property(nexts))</visible>
			</control>
			<control type="textbox">
				<left>30</left>
				<top>604</top>
				<width>590</width>
				<height>310</height>
				<font>font12</font>
				<textcolor>FFE6EDF3</textcolor>
				<label>$INFO[Container(50).ListItem.Property(nexts)]</label>
				<visible>!String.IsEmpty(Container(50).ListItem.Property(nexts))</visible>
			</control>
			<control type="button" id="62">
				<left>0</left>
				<top>0</top>
				<width>650</width>
				<height>366</height>
				<visible>Player.HasVideo</visible>
				<texturefocus border="4" colordiffuse="FF3B82F6">frame.png</texturefocus>
				<onleft>50</onleft>
				<onup>60</onup>
			</control>
		</control>
		<control type="button" id="61">
			<left>1230</left>
			<top>22</top>
			<width>300</width>
			<height>64</height>
			<label>Διακοπή</label>
			<font>font13</font>
			<textcolor>FFFFFFFF</textcolor>
			<focusedcolor>FFFFFFFF</focusedcolor>
			<align>center</align>
			<aligny>center</aligny>
			<visible>Player.HasVideo</visible>
			<texturenofocus colordiffuse="FF30363D">white.png</texturenofocus>
			<texturefocus colordiffuse="FF1F4E8C">white.png</texturefocus>
			<onright>60</onright>
			<ondown>62</ondown>
			<ondown>50</ondown>
			<onleft>50</onleft>
		</control>
		<control type="button" id="60">
			<left>1560</left>
			<top>22</top>
			<width>300</width>
			<height>64</height>
			<label>Πίσω</label>
			<font>font13</font>
			<textcolor>FFFFFFFF</textcolor>
			<focusedcolor>FFFFFFFF</focusedcolor>
			<align>center</align>
			<aligny>center</aligny>
			<texturenofocus colordiffuse="FF30363D">white.png</texturenofocus>
			<texturefocus colordiffuse="FF1F4E8C">white.png</texturefocus>
			<ondown>62</ondown>
			<ondown>50</ondown>
			<onleft>61</onleft>
			<onleft>50</onleft>
		</control>
	</controls>
</window>
