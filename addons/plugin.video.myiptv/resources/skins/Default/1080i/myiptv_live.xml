			<left>60</left>
			<top>110</top>
			<width>1110</width>
			<height>930</height>
			<orientation>vertical</orientation>
			<scrolltime>150</scrolltime>
			<pagecontrol>51</pagecontrol>
			<onup>60</onup>
			<onright condition="Control.IsVisible(51)">51</onright>
			<onright condition="!Control.IsVisible(51) + Player.HasMedia">62</onright>
			<onright condition="!Control.IsVisible(51) + !Player.HasMedia">60</onright>
			<itemlayout height="96" width="1110">
				<control type="image">
					<left>10</left>
					<top>8</top>
					<width>80</width>
					<height>80</height>
					<aspectratio>keep</aspectratio>
