<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<controls>
		<!-- only the add-on's own texture (white.png) and the font names every skin defines are used, so the window
		     looks the same in any skin; drawn in 1920x1080 units, Kodi scales it to the screen -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="FF0D1117">white.png</texture>
		</control>
		<control type="label">
			<left>60</left>
			<top>28</top>
			<width>1800</width>
			<height>60</height>
			<font>font14</font>
			<textcolor>FFFFFFFF</textcolor>
			<label>$INFO[Window.Property(title)]</label>
		</control>
