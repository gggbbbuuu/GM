				<label>$INFO[Container(50).ListItem.Label]</label>
			</control>
			<control type="label">
				<left>30</left>
				<top>432</top>
				<width>590</width>
				<height>34</height>
				<font>font12</font>
				<textcolor>FF8B949E</textcolor>
				<label>$INFO[Container(50).ListItem.Property(nowlabel)]</label>
				<visible>!String.IsEmpty(Container(50).ListItem.Property(now))</visible>
			</control>
			<control type="textbox">
				<left>30</left>
				<top>468</top>
				<width>590</width>
				<height>90</height>
				<font>font13</font>
				<textcolor>FF7DD3FC</textcolor>
				<label>$INFO[Container(50).ListItem.Property(when),[COLOR FFF2C94C],[/COLOR]  ]$INFO[Container(50).ListItem.Property(now)]</label>
				<visible>!String.IsEmpty(Container(50).ListItem.Property(now))</visible>
			</control>
			<control type="label">
				<left>30</left>
				<top>566</top>
				<width>590</width>
				<height>34</height>
				<font>font12</font>
				<textcolor>FF8B949E</textcolor>
				<label>$INFO[Container(50).ListItem.Property(nextlabel)]</label>
				<visible>!String.IsEmpty(Container(50).ListItem.Property(nexts))</visible>
			</control>
			<control type="textbox">
				<left>30</left>
				<top>604</top>
				<width>590</width>
				<height>310</height>
				<font>font12</font>
				<textcolor>FFE6EDF3</textcolor>
				<label>$INFO[Container(50).ListItem.Property(nexts)]</label>
