			</control>
			<control type="button" id="62">
				<left>0</left>
				<top>0</top>
				<width>650</width>
				<height>366</height>
				<visible>Player.HasMedia</visible>
				<texturefocus border="4" colordiffuse="FF3B82F6">frame.png</texturefocus>
				<onleft condition="Control.IsVisible(51)">51</onleft>
				<onleft condition="!Control.IsVisible(51)">50</onleft>
				<onup>60</onup>
			</control>
		</control>
		<!-- scroll bar of the channel list: Right from the list leads to it, Right again to the video frame (while a video
		     plays) or to the Back button; it is only there when the list is longer than one page -->
		<control type="scrollbar" id="51">
			<left>1180</left>
			<top>110</top>
			<width>16</width>
			<height>930</height>
			<texturesliderbackground colordiffuse="FF21262D">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="FF484F58">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="FF3B82F6">white.png</texturesliderbarfocus>
			<textureslidernib colordiffuse="FF484F58">white.png</textureslidernib>
			<textureslidernibfocus colordiffuse="FF3B82F6">white.png</textureslidernibfocus>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onleft>50</onleft>
			<onright condition="Player.HasMedia">62</onright>
			<onright condition="!Player.HasMedia">60</onright>
		</control>
		<control type="button" id="61">
			<left>1230</left>
			<top>22</top>
			<width>300</width>
			<height>64</height>
			<label>Διακοπή</label>
			<font>font13</font>
			<textcolor>FFFFFFFF</textcolor>
			<focusedcolor>FFFFFFFF</focusedcolor>
			<align>center</align>
			<aligny>center</aligny>
			<visible>Player.HasMedia</visible>
			<texturenofocus colordiffuse="FF30363D">white.png</texturenofocus>
			<texturefocus colordiffuse="FF1F4E8C">white.png</texturefocus>
			<onright>60</onright>
			<ondown condition="Player.HasMedia">62</ondown>
			<ondown condition="!Player.HasMedia">50</ondown>
			<onleft>50</onleft>
		</control>
		<control type="button" id="60">
			<left>1560</left>
			<top>22</top>
			<width>300</width>
			<height>64</height>
			<label>Πίσω</label>
			<font>font13</font>
			<textcolor>FFFFFFFF</textcolor>
			<focusedcolor>FFFFFFFF</focusedcolor>
			<align>center</align>
			<aligny>center</aligny>
			<texturenofocus colordiffuse="FF30363D">white.png</texturenofocus>
			<texturefocus colordiffuse="FF1F4E8C">white.png</texturefocus>
			<ondown condition="Player.HasMedia">62</ondown>
			<ondown condition="!Player.HasMedia">50</ondown>
			<onleft condition="Player.HasMedia">61</onleft>
			<onleft condition="!Player.HasMedia + Control.IsVisible(51)">51</onleft>
			<onleft condition="!Player.HasMedia + !Control.IsVisible(51)">50</onleft>
		</control>
	</controls>
</window>
