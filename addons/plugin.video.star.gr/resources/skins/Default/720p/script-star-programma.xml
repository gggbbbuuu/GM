        <!-- Dimmed fullscreen background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1280</width>
            <height>720</height>
            <texture>white.png</texture>
            <colordiffuse>CC000000</colordiffuse>
        </control>

        <!-- Dialog panel -->
        <control type="image">
            <left>140</left>
            <top>60</top>
            <width>1000</width>
            <height>600</height>
            <texture>white.png</texture>
            <colordiffuse>FF141923</colordiffuse>
        </control>

        <!-- Header: title (left) and selected day (right) -->
        <control type="label" id="1">
            <left>170</left>
            <top>80</top>
            <width>600</width>
            <height>40</height>
            <font>font13</font>
            <textcolor>FFFFD200</textcolor>
