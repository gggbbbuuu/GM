            <left>170</left>
            <top>130</top>
            <width>940</width>
            <height>64</height>
            <orientation>horizontal</orientation>
            <ondown>101</ondown>
            <itemlayout width="150" height="64">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>150</width>
                    <height>64</height>
                    <font>font12</font>
                    <textcolor>FFAAAAAA</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <info>ListItem.Label</info>
                </control>
            </itemlayout>
            <focusedlayout width="150" height="64">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>150</width>
                    <height>64</height>
                    <texture>white.png</texture>
                    <colordiffuse>FFFFD200</colordiffuse>
                    <visible>Control.HasFocus(100)</visible>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>150</width>
                    <height>64</height>
                    <font>font12</font>
                    <textcolor>FF000000</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <visible>Control.HasFocus(100)</visible>
