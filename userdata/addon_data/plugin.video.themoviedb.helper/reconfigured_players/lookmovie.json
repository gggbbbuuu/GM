{
    "name"              : "[COLOR gold]Look[COLOR red]Movie[/COLOR]",
    "language"          : "en",
    "api_language"      : "en-US",
    "icon"              : "https://gknwizard.eu/repo/Builds/GKoBu/Plugins/matrix/plugin.video.lookmovietomb/icon.png",
    "plugin"            : "plugin.video.themoviedb.helper",
    "priority"          : 97,
    "play_movie"        : [
                            "plugin://plugin.video.lookmovietomb/?mode=listmovies&url=https%3A%2F%2FGKoBuMovies{en_clearname_url+}&page=1",
                            {"dialog": "auto", "label": "(?i)^{en_clearname}$", "year": "{year}", "strict": "true"},
                            {"dialog": "auto"}
                          ],
    "play_episode"      : [
                            "plugin://plugin.video.lookmovietomb/?mode=listmovies&url=https%3A%2F%2FGKoBuShows{en_clearname_url+}&page=1",
                            {"dialog": "auto", "label": "(?i)^{en_clearname}$", "strict": "true"},
                            {"dialog": "auto", "label": "(?i).*Season (?:0{season}|{season})$", "strict": "true"},
                            {"dialog": "auto", "label": "(?i).*S(?:0{season}|{season})E(?:0{episode}|{episode})[^0-9]", "strict": "true"},
                            {"dialog": "auto"}
                          ],
    "is_resolvable"     : "true"
}