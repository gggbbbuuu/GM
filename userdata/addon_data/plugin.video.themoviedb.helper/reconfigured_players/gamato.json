{
    "name"              : "[COLOR grey]Gamato[/COLOR]",
    "language"          : "el",
    "api_language"      : "en-US",
    "icon"              : "special://home/addons/script.module.grs/resources/icons/gamato.jpg",
    "plugin"            : "plugin.video.microjen",
    "fallback"          : {"play_movie": "gamato.json search_movie"},
    "priority"          : 98,
    "play_movie"        : [
                            "plugin://script.module.grs/?mode=gamatosearch&url=movies",
                            {"keyboard": "{en_clearname}"},
                            {"dialog": "auto", "label": "(?i)^(?:{en_clearname}|{el_clearname}) {year}", "strict": "true"},
                            {"dialog": "auto"}
                          ],
    "search_movie"        : [
                            "plugin://script.module.grs/?mode=gamatosearch&url=movies",
                            {"keyboard": "{el_clearname}"},
                            {"dialog": "auto", "label": "(?i)^(?:{en_clearname}|{el_clearname}) {year}", "strict": "true"},
                            {"dialog": "auto"}
                          ],
    "play_episode"      : [
                            "plugin://script.module.grs/?mode=gamatosearch&url=series",
                            {"keyboard": "{en_clearname}"},
                            {"dialog": "auto", "label": "(?i)^(?:{en_clearname}$|{originaltitle}$)", "strict": "true"},
                            {"dialog": "auto", "label": "(?i).*S(?:0{season}|{season})E(?:0{episode}|{episode})[^0-9]", "strict": "true", "return": "true"},
                            {"dialog": "auto"}
                          ],
    "is_resolvable"     : "true"
}